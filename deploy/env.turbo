# TURBO — максимальная скорость рассылки stories
# Скопируй нужные строки в .env и перезапусти рассылку

MAX_SESSIONS=900
MAX_CONCURRENT=900
DELAY_MESSAGES=0
DELAY_CYCLES=0
REFRESH_INTERVAL=1800
ERROR_DELAY=0.05
WORKER_RETRY_SLEEP=2
PROXY_COOLDOWN=30
STORY_BAD_TTL=60
PROXY_RELOAD_INTERVAL=10
DIALOGS_LIMIT=400
CONTACT_MAX_OFFLINE_DAYS=14
CONTACT_INCLUDE_DIALOGS=1
LOG_SUCCESS_EVERY=-1
LOG_SESSION_EVENTS=0
DISPATCHER_PROXY_WAIT=0
MAX_ERRORS=25
