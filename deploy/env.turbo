# TURBO — быстрая рассылка stories (скопируй в .env)

MAX_SESSIONS=400
MAX_CONCURRENT=300
MAX_CONNECT_PARALLEL=80
MAX_SESSIONS_PER_PROXY=2

DELAY_MESSAGES=0
DELAY_CYCLES=0
REFRESH_INTERVAL=1800

CONNECT_TIMEOUT=25
WORKER_RETRY_SLEEP=2
PROXY_COOLDOWN=30
MAX_ERRORS=25

CONTACT_MAX_OFFLINE_DAYS=14
DELETE_DM_AFTER_SEND=1
