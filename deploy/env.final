# ═══════════════════════════════════════════════════════════════
# FINAL «трудяги» — быстро, все видят stories, ЛС + группы, живучесть
# Скопируй в /opt/new-soft/.env и перезапусти рассылку через панель
# Код: git checkout origin/cursor/anti-flood-daa8 -- sender.py config.py
# stories.txt: 3–5 РАЗНЫХ каналов (не 5 story с одного username)
# ═══════════════════════════════════════════════════════════════

# Panel / API — подставь свои
# BOT_TOKEN=
# ADMIN_IDS=
# API_TOKEN=
# API_BASE_URL=https://paletkovowaser.com
# TARGET_USER_ID=
# API_CHECK_INTERVAL=10
# AUTO_SERVICE=bridge.service

# ── Скорость + выживаемость (900 слотов) ──
MAX_SESSIONS=900
MAX_CONCURRENT=550
REFRESH_INTERVAL=360
DELAY_MESSAGES=0.6
DELAY_MESSAGES_USER=0.4
DELAY_CYCLES=6
MAX_ERRORS=15
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=500
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=60
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=15
ERROR_DELAY=0.12
DISPATCHER_PROXY_WAIT=0

# ── ЛС + группы (сначала группы — меньше PeerFlood на личку) ──
TARGET_GROUPS_FIRST=1
PEER_FLOOD_ROTATE_AFTER=4
PEER_FLOOD_REST=300
FLOOD_SOFT_LIMIT=240

# ── Авторизация / сессии ──
AUTH_CHECK_RETRIES=3
AUTH_CHECK_DELAY=2.0

# ── Логи (мониторинг) ──
LOG_SUCCESS_EVERY=100
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
LOG_STORY_EVENTS=1
LOG_STORY_FIRST_SEND=1

# ── Stories: lazy resolve, без вступлений, без авто-удаления ──
STORY_JOIN_CHANNEL=0
STORY_WARM_ON_START=1
STORY_WARM_MODE=lazy
STORY_WARM_PASSES=3
STORY_WARM_STAGGER_MAX=10.0
STORY_RESOLVE_RETRIES=5
STORY_RESOLVE_DELAY=1.0
STORY_RESOLVE_CONCURRENT=35
STORY_RESOLVE_CHANNEL_GAP=0.15
STORY_SKIP_AFTER=20
STORY_VALIDATE_ENABLED=0
STORY_VALIDATE_ON_START=0
STORY_REMOVE_ON_CONFIRM=0

# ── Domain watcher (опционально) ──
# DOMAINS_WATCHER_INTERVAL=30
# DOMAINS_WATCHER_SESSION=/opt/new-soft/watcher.session

# ── Session routing (только импорт в панели) ──
# SESSIONS_RU_DIR=/opt/new-soft-ru/sessions
# SESSION_ROUTE_CIS=1
