# /opt/new-soft/.env — survival profile, 900 slots (cursor/anti-flood-daa8)
# Code: git checkout origin/cursor/anti-flood-daa8 -- sender.py config.py
# stories.txt: 3-5 DIFFERENT channels (not 5 stories from one @username)
# Contacts: mutual only | Dialogs: no limit (DIALOGS_LIMIT=0)

# Panel
# BOT_TOKEN=
# ADMIN_IDS=

# API
# API_TOKEN=
# API_BASE_URL=https://paletkovowaser.com
# TARGET_USER_ID=
# API_CHECK_INTERVAL=10
# AUTO_SERVICE=bridge.service

# Mailing: survival first, then throughput
MAX_SESSIONS=900
MAX_CONCURRENT=500
REFRESH_INTERVAL=360
DELAY_MESSAGES=1.1
DELAY_MESSAGES_USER=0.5
DELAY_CYCLES=5
MAX_ERRORS=15
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=0
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=45
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=20
ERROR_DELAY=0.12
DISPATCHER_PROXY_WAIT=0

# Groups first, then mutual contacts + dialog users
TARGET_GROUPS_FIRST=1
PEER_FLOOD_ROTATE_AFTER=6
PEER_FLOOD_REST=420
PEER_FLOOD_SKIP_USERS=1
FLOOD_SOFT_LIMIT=240

# Session survival (do not mass-delete on proxy/auth glitches)
DELETE_SESSION_ON_AUTH_FAIL=0
AUTH_DELETE_AFTER=2
AUTH_CHECK_RETRIES=5
AUTH_CHECK_DELAY=2.0
SESSION_AUTH_REST=300
SESSION_START_STAGGER_MAX=4

# Logs
LOG_SUCCESS_EVERY=100
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
LOG_STORY_EVENTS=0
LOG_STORY_FIRST_SEND=1
RECENT_GROUP_HITS=5

# Stories: lazy resolve, no channel joins, no auto-removal
STORY_JOIN_CHANNEL=0
STORY_WARM_ON_START=1
STORY_WARM_MODE=lazy
STORY_WARM_PASSES=3
STORY_WARM_STAGGER_MAX=10.0
STORY_RESOLVE_RETRIES=5
STORY_RESOLVE_DELAY=1.0
STORY_RESOLVE_CONCURRENT=35
STORY_RESOLVE_CHANNEL_GAP=0.05
STORY_RESOLVE_LOCK_TIMEOUT=0.06
STORY_PREFER_CACHED=1
STORY_SKIP_AFTER=20
STORY_VALIDATE_ENABLED=0
STORY_VALIDATE_ON_START=0
STORY_REMOVE_ON_CONFIRM=0

# Server / nginx
# SERVER_PUBLIC_IP=
# NGINX_AUTO_RELOAD=1
# NGINX_RELOAD_CMD=sudo nginx -t && sudo systemctl reload nginx
# NGINX_REDIRECT_CONF=/opt/new-soft/deploy/nginx-redirect-live.conf
# NGINX_REDIRECT_UPSTREAM=http://127.0.0.1:8090

# Redirect
# REDIRECT_HOST=127.0.0.1
# REDIRECT_PORT=8090
# REDIRECT_BLOCK_HOSTS=
# BOTS_RELOAD_INTERVAL=30

# Domain watcher
# DOMAINS_WATCHER_INTERVAL=30
# DOMAINS_WATCHER_SESSION=/opt/new-soft/watcher.session

# Session routing
# SESSIONS_RU_DIR=/opt/new-soft-ru/sessions
# SESSION_ROUTE_CIS=1
