# FINAL — stories рассылка: все аккаунты видят истории, подробные логи
# Скопируй в .env и перезапусти рассылку через панель

MAX_SESSIONS=1500
MAX_CONCURRENT=800
REFRESH_INTERVAL=420
DELAY_MESSAGES=0.55
DELAY_MESSAGES_USER=0.35
DELAY_CYCLES=5
MAX_ERRORS=15
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=500
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=60
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=12
ERROR_DELAY=0.1
LOG_SUCCESS_EVERY=100
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
LOG_STORY_EVENTS=1
LOG_STORY_FIRST_SEND=1
DISPATCHER_PROXY_WAIT=0
TARGET_GROUPS_FIRST=1
PEER_FLOOD_ROTATE_AFTER=3
PEER_FLOOD_REST=300
FLOOD_SOFT_LIMIT=240
AUTH_CHECK_RETRIES=3
AUTH_CHECK_DELAY=2.0

# Stories — без вступлений в каналы, с прогревом и ретраями
STORY_JOIN_CHANNEL=0
STORY_WARM_ON_START=1
STORY_WARM_PASSES=3
STORY_RESOLVE_RETRIES=5
STORY_RESOLVE_DELAY=0.5
STORY_SKIP_AFTER=15
STORY_VALIDATE_ENABLED=0
STORY_REMOVE_ON_CONFIRM=0
