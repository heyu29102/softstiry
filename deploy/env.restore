# RESTORE — баланс скорости и живучести сессий + больше логов
# 1500 слотов, 900 параллельно (не 1500 — убивает аккаунты)

MAX_SESSIONS=1500
MAX_CONCURRENT=800
REFRESH_INTERVAL=360
DELAY_MESSAGES=0.85
DELAY_MESSAGES_USER=0.65
DELAY_CYCLES=8
MAX_ERRORS=15
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=400
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=75
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=10
ERROR_DELAY=0.12
LOG_SUCCESS_EVERY=5
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
DISPATCHER_PROXY_WAIT=0
TARGET_GROUPS_FIRST=1
PEER_FLOOD_SKIP_USERS=1
PEER_FLOOD_ROTATE_AFTER=3
PEER_FLOOD_REST=240
FLOOD_SOFT_LIMIT=240
AUTH_CHECK_RETRIES=3
AUTH_CHECK_DELAY=2.0
NEW_SESSION_GRACE_SEC=240
API_CHECK_INTERVAL=5

# Роутинг: CIS/RU сессии уходят в SESSIONS_RU_DIR — sender теперь читает ОБЕ папки
SESSIONS_RU_DIR=/opt/new-soft-ru/sessions
SESSION_ROUTE_CIS=1
