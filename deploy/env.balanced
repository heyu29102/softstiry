# Баланс: высокая скорость + меньше PeerFlood на ЛС
# Группы первыми, при PeerFlood — только группы, мёртвые stories в бан

MAX_SESSIONS=900
MAX_CONCURRENT=900
REFRESH_INTERVAL=600
DELAY_MESSAGES=0.35
DELAY_CYCLES=3
MAX_ERRORS=20
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=400
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=60
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=5
ERROR_DELAY=0.08
LOG_SUCCESS_EVERY=100
LOG_SESSION_EVENTS=0
DISPATCHER_PROXY_WAIT=0
TARGET_GROUPS_FIRST=1
PEER_FLOOD_SKIP_USERS=1
PEER_FLOOD_ROTATE_AFTER=3
PEER_FLOOD_REST=120
