# SAFE — бережно к сессиям, норм скорость, больше логов
# Для 1500 слотов: не гони MAX_CONCURRENT=1500 — убьёт аккаунты

MAX_SESSIONS=1500
MAX_CONCURRENT=600
REFRESH_INTERVAL=300
DELAY_MESSAGES=0.9
DELAY_MESSAGES_USER=0.7
DELAY_CYCLES=8
MAX_ERRORS=15
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=400
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=90
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=15
ERROR_DELAY=0.15
LOG_SUCCESS_EVERY=25
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
DISPATCHER_PROXY_WAIT=0
TARGET_GROUPS_FIRST=1
PEER_FLOOD_SKIP_USERS=1
PEER_FLOOD_ROTATE_AFTER=2
PEER_FLOOD_REST=300
FLOOD_SOFT_LIMIT=180
