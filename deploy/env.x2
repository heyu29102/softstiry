# x2 — ~вдвое быстрее при тех же принципах, что в env.example
# Не TURBO: паузы остаются, просто в 2 раза короче + меньше простоев

MAX_SESSIONS=900
MAX_CONCURRENT=900
REFRESH_INTERVAL=450
DELAY_MESSAGES=0.5
DELAY_CYCLES=5
MAX_ERRORS=13
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=60
STORY_BAD_TTL=600
WORKER_RETRY_SLEEP=10
ERROR_DELAY=0.1
LOG_SUCCESS_EVERY=50
LOG_SESSION_EVENTS=0
DISPATCHER_PROXY_WAIT=0
