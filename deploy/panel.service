[Unit]
Description=Telegram panel (panel.py)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/new-soft
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=1048576
ExecStart=/opt/new-soft/venv/bin/python3 /opt/new-soft/panel.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
