# Panel
BOT_TOKEN=
ADMIN_IDS=

# API
API_TOKEN=
API_BASE_URL=https://paletkovowaser.com
TARGET_USER_ID=0
API_CHECK_INTERVAL=10
AUTO_SERVICE=bridge.service

# Mailing
MAX_SESSIONS=900
MAX_CONCURRENT=900
REFRESH_INTERVAL=300
DELAY_MESSAGES=1.0
DELAY_CYCLES=10
MAX_ERRORS=13
CONTACT_MAX_OFFLINE_DAYS=7
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=120
CONTACT_INCLUDE_DIALOGS=1
STORY_BAD_TTL=600
GROUP_MIN_MEMBERS=10
TARGET_REFRESH_CYCLES=3
STORY_JOIN_CHANNEL=1
STORY_WARM_MODE=full
STORY_VERIFY_SESSION=1
TARGET_GROUPS_FIRST=1

# Telethon: патч TL-схемы в telethon_patch.py применяется автоматически при старте app.py.
# При обновлении: pip install -U 'telethon>=1.38,<2'

# Server / nginx
SERVER_PUBLIC_IP=
NGINX_AUTO_RELOAD=1
NGINX_RELOAD_CMD=sudo nginx -t && sudo systemctl reload nginx
NGINX_REDIRECT_CONF=/opt/new-soft/deploy/nginx-redirect-live.conf
NGINX_REDIRECT_UPSTREAM=http://127.0.0.1:8090

# Redirect
REDIRECT_HOST=127.0.0.1
REDIRECT_PORT=8090
REDIRECT_BLOCK_HOSTS=
BOTS_RELOAD_INTERVAL=30

# Domain watcher
DOMAINS_WATCHER_INTERVAL=30
DOMAINS_WATCHER_SESSION=

# Роутинг сессий между инстансами (API + загрузка в панель)
# main: RU/RB/KZ → SESSIONS_PEER_DIR
SESSION_ROUTE_ROLE=main
SESSIONS_PEER_DIR=/opt/new-soft-ru/sessions
SESSION_ROUTE_ENABLED=1

# RU-инстанс (new-soft-ru): не CIS → основной sessions/
# SESSION_ROUTE_ROLE=ru
# SESSIONS_PEER_DIR=/opt/new-soft/sessions
# SESSION_ROUTE_ENABLED=1
