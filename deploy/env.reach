# REACH — все аккаунты видят stories + группы первыми
# bash deploy/apply-env-profile.sh /opt/new-soft reach

STORY_JOIN_CHANNEL=1
STORY_WARM_ON_START=1
STORY_WARM_MODE=full
STORY_WARM_PASSES=3
STORY_WARM_STAGGER_MAX=2
STORY_VERIFY_SESSION=1
STORY_RESOLVE_RETRIES=6
STORY_RESOLVE_DELAY=0.5
STORY_RESOLVE_LOCK_TIMEOUT=0.2
STORY_PREFER_CACHED=0
TARGET_GROUPS_FIRST=1
TARGET_REFRESH_CYCLES=3
GROUP_MIN_MEMBERS=10
LOG_SUCCESS_GROUPS=1
PEER_FLOOD_SKIP_USERS=1
CONTACT_INCLUDE_DIALOGS=1
