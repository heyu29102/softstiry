# stories mailing | x3 + story reach (join, full warm, verify)
# На сервере: скопируй секреты из старого .env, затем:
#   grep -v '^[A-Z]' .env > /tmp/keep.txt  # или вручную Panel/API/nginx
#   cat deploy/env.production >> .env
# Либо замени только блок Mailing ниже.

# --- Mailing: x3 balanced + все аккаунты видят stories ---
MAX_SESSIONS=1000
MAX_CONCURRENT=1000
REFRESH_INTERVAL=360
DELAY_MESSAGES=1
DELAY_MESSAGES_USER=1
DELAY_CYCLES=3
MAX_ERRORS=18
CONTACT_MAX_OFFLINE_DAYS=7
CONTACT_INCLUDE_DIALOGS=1
DIALOGS_LIMIT=800
STORIES_RELOAD_INTERVAL=30
PROXY_COOLDOWN=45
PROXY_RELOAD_INTERVAL=10
STORY_BAD_TTL=300
WORKER_RETRY_SLEEP=8
ERROR_DELAY=0.08

# Группы первыми, потом ЛС
TARGET_GROUPS_FIRST=1
TARGET_REFRESH_CYCLES=3
GROUP_MIN_MEMBERS=0

# Проверка get_messages после send (для групп ломало доставку — держим выкл.)
STORY_JOIN_CHANNEL=1
STORY_WARM_ON_START=1
STORY_WARM_MODE=full
STORY_WARM_PASSES=3
STORY_WARM_STAGGER_MAX=2
STORY_VERIFY_SESSION=1
STORY_CONFIRM_IN_CHAT=0
STORY_CONFIRM_GROUPS=0
STORY_RESOLVE_RETRIES=6
STORY_RESOLVE_DELAY=0.5
STORY_RESOLVE_CONCURRENT=50
STORY_RESOLVE_CHANNEL_GAP=0.03
STORY_RESOLVE_LOCK_TIMEOUT=0.2
STORY_PREFER_CACHED=0
STORY_SKIP_AFTER=20

# Flood / выживаемость
PEER_FLOOD_PAUSE=5
PEER_FLOOD_ROTATE_AFTER=8
PEER_FLOOD_REST=180
PEER_FLOOD_SKIP_USERS=1
FLOOD_SOFT_LIMIT=450
DELETE_SESSION_ON_AUTH_FAIL=0
AUTH_DELETE_AFTER=3
AUTH_CHECK_RETRIES=5
AUTH_CHECK_DELAY=1.5
SESSION_AUTH_REST=120
SESSION_START_STAGGER_MAX=2
DISPATCHER_PROXY_WAIT=0

# Логи
LOG_SUCCESS_EVERY=100
LOG_SUCCESS_GROUPS=1
LOG_SESSION_EVENTS=0
LOG_STORY_EVENTS=0
LOG_STORY_FIRST_SEND=1
