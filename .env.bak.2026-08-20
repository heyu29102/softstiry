# stories mailing | API ~100/30min | ~19k mature pool + fresh imports with rest
# Panel
BOT_TOKEN=8589373526:AAE2z-VI1qMUSAa-0wL3CuXkWvTW_AWaoL4
ADMIN_IDS=8608327989
# API
API_TOKEN=jvjjV4a0mJRMuIU7YkJD2Kaj61UjJha6uH2HKIRm
API_BASE_URL=https://paletkovowaser.com
TARGET_USER_ID=8608327989
API_CHECK_INTERVAL=10
AUTO_SERVICE=bridge.service
# Mailing (mature sessions)
MAX_SESSIONS=400
MAX_CONCURRENT=350
REFRESH_INTERVAL=300
DELAY_MESSAGES=1.2
DELAY_CYCLES=15
MAX_ERRORS=8
CONTACT_MAX_OFFLINE_DAYS=7
STORIES_RELOAD_INTERVAL=30
# Lifecycle (rest only for files younger than SESSION_REST_SECONDS)
SESSION_REST_SECONDS=1800
SESSION_REST_RELEASE_PER_MIN=8
SESSION_WARMUP_MESSAGES=20
SESSION_WARMUP_DELAY=3.0
SESSION_WARMUP_CYCLE_DELAY=20
SESSION_WARMUP_MAX_PER_STINT=6
SESSION_WARMUP_STINT_SEC=120
SESSION_FLOOD_REST_SECONDS=3600
MAX_WARMUP_ACTIVE=60
# Proxies
PROXY_COOLDOWN=45
# Server / nginx
SERVER_PUBLIC_IP=138.124.123.159
NGINX_AUTO_RELOAD=1
NGINX_RELOAD_CMD=sudo nginx -t && sudo systemctl reload nginx
NGINX_REDIRECT_CONF=/opt/new-soft/deploy/nginx-redirect-live.conf
NGINX_REDIRECT_UPSTREAM=http://127.0.0.1:8090
# Redirect
REDIRECT_HOST=127.0.0.1
REDIRECT_PORT=8090
REDIRECT_BLOCK_HOSTS=
BOTS_RELOAD_INTERVAL=30
# Domain watcher
DOMAINS_WATCHER_INTERVAL=30
DOMAINS_WATCHER_SESSION=/opt/new-soft/watcher.session
# Session routing (RU/RB/KZ -> peer)
SESSION_ROUTE_ROLE=main
SESSIONS_PEER_DIR=/opt/new-soft-ru/sessions
SESSION_ROUTE_ENABLED=1